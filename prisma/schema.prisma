// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id            String   @id @default(cuid())
  name          String
  phone         String?
  email         String?
  website       String?
  address       String?
  city          String?
  rating        Float?
  reviewsCount  Int?
  category      String?
  status        String   @default("new") // new | contacted | interested | closed | rejected
  preferredChannel String? // whatsapp | email
  lastContactAt DateTime?
  notes         String?
  googleMapsUrl String?
  latitude      Float?
  longitude     Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages Message[]
}

model Message {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  channel   String   // whatsapp | email
  content   String
  status    String   @default("sent") // sent | failed | delivered
  sentAt    DateTime @default(now())
}

model Settings {
  id              String @id @default(cuid())
  apifyToken      String @default("")
  evolutionApiUrl String @default("")
  evolutionApiKey String @default("")
  evolutionInstance String @default("")
  zohoSmtpHost    String @default("smtp.zoho.com")
  zohoSmtpPort    Int    @default(465)
  zohoEmail       String @default("")
  zohoPassword    String @default("")
  updatedAt       DateTime @updatedAt
}
